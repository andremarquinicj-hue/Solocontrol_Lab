rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function profile(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role(){ return signedIn() && profile().data.active == true ? profile().data.role : null; }
    function internal(){ return role() in ['admin','coordinator','technician','engineer']; }
    function manager(){ return role() in ['admin','coordinator']; }
    function approver(){ return role() in ['admin','engineer']; }
    function clientCanRead(workId){ return role() == 'client' && workId in profile().data.allowedWorkIds; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role() in ['admin','coordinator']);
      allow write: if role() == 'admin';
    }
    match /works/{id} { allow read: if internal() || clientCanRead(id); allow write: if manager(); }
    match /samples/{id} { allow read: if internal() || clientCanRead(resource.data.workId); allow create,update: if internal(); allow delete: if role() == 'admin'; }
    match /team/{id} { allow read: if internal(); allow write: if manager(); }
    match /equipment/{id} { allow read: if internal(); allow write: if manager(); }
    match /nonConformities/{id} { allow read: if internal(); allow write: if internal(); }
    match /checklists/{id} { allow read,write: if internal(); }
    match /audit/{id} { allow read: if role() in ['admin','coordinator','engineer']; allow create: if internal(); allow update,delete: if false; }
  }
}
